# cp .env.example .env; set secrets before remote deployment
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=replace-with-random-32-byte-hex
ENCRYPTION_KEY=generate-using-python-cryptography-fernet
API_INGEST_KEY=replace-with-long-random-automation-token
API_WORKER_KEY=replace-with-a-different-random-worker-token
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATA_DIR=./data
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
META_API_VERSION=v25.0
# NEVER true until approved Meta OAuth and owner verifies correct IG account
ENABLE_LIVE_PUBLISH=false
EXPECTED_INSTAGRAM_USERNAME=
TIMEZONE=Asia/Seoul

RUN_WORKER=true
# Set true with a mounted persistent disk in production
REQUIRE_PERSISTENT_DATA=false
